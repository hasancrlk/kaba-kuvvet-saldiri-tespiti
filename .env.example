# --- Veritabani ---
DATABASE_URL=sqlite+aiosqlite:///./authwatch.db
# DATABASE_URL=postgresql+asyncpg://authwatch:authwatch@localhost:5432/authwatch

# --- Tespit esikleri: "ayni IP'den Y saniye icinde X basarisiz deneme" ---
DETECT_THRESHOLD=5
DETECT_WINDOW_SECONDS=60
# Ayni IP icin pes pese alarm uretmemek icin soguma suresi.
DETECT_COOLDOWN_SECONDS=300
# Alarm uretilmeyecek IP'ler (ofis cikisi, izleme sistemi...).
DETECT_ALLOWLIST=

# --- Olasi hesap ele gecirme ---
TAKEOVER_FAILURES=5
TAKEOVER_WINDOW_SECONDS=600

# --- Yukleme sinirlari ---
MAX_LINES_PER_INGEST=200000
MAX_SKIPPED_STORED=200

# --- Zenginlestirme (opsiyonel) ---
# MaxMind mmdb yolu. Bos ise yalnizca IP kapsami (ozel/genel) raporlanir.
# GEOIP_DB_PATH=/opt/geoip/GeoLite2-City.mmdb
